{
  "expo": {
    "name": "Mitro Artist",
    "slug": "mitro-artist",
    "version": "1.1.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "scheme": "mitroartist",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#05040B",
    "icon": "./src/static/images/icon.png",
    "splash": {
      "image": "./src/static/images/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#05040B"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mitro.artist.demo",
      "config": {
        "usesNonExemptEncryption": false
      },
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.mitro.artist",
      "backgroundColor": "#05040B",
      "adaptiveIcon": {
        "foregroundImage": "./src/static/images/icon-adaptive.png",
        "backgroundColor": "#FFFFFF"
      },
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./src/static/images/notification-icon.png",
          "color": "#FF3FAD"
        }
      ],
      "./plugins/withNotificationColorMergeFix",
      [
        "expo-image-picker",
        {
          "photosPermission": "Mitro Artist uses your photos so you can set your profile picture."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/static/images/splash-logo.png",
          "backgroundColor": "#05040B",
          "resizeMode": "contain",
          "imageWidth": 180
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://artist-api.mitro.live",
      "apiTimeoutMs": 20000,
      "router": {
        "origin": false
      },
      "useMock": false
    }
  }
}
