# Template for local setup — copy to .env and fill in.
#
#   cp .env.example .env
#
# Expo inlines every EXPO_PUBLIC_* variable into the JS bundle, so all values
# here are PUBLIC. Never add secrets, private keys or admin tokens.

# API base URL. Release builds require https://; dev builds may use http://
# to reach a server on the local network.
EXPO_PUBLIC_API_BASE_URL=https://api.mitro.app

# Request timeout in milliseconds.
EXPO_PUBLIC_API_TIMEOUT_MS=20000

# true = fixtures + demo login, false = real API.
EXPO_PUBLIC_USE_MOCK=false

# Allows a release build to use a plaintext http:// API. Only for internal test
# APKs pointed at a LAN server. MUST be false for anything shipped.
EXPO_PUBLIC_ALLOW_INSECURE=false
